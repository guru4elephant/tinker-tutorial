<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tinker 热修复 Demo"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Tinker 状态信息 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="加载中..."
        android:textSize="14sp"
        android:background="#f0f0f0"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Bug 演示结果 -->
    <TextView
        android:id="@+id/tv_bug_demo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击下方按钮查看 Bug 演示"
        android:textSize="16sp"
        android:textColor="#333333"
        android:padding="12dp"
        android:background="#fff3cd"
        android:layout_marginBottom="24dp" />

    <!-- 操作按钮 -->
    <Button
        android:id="@+id/btn_show_bug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="展示 Bug（1 + 1 = ?）"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_load_patch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="加载补丁"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_clean_patch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清除补丁"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_kill_process"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="杀掉进程（使补丁生效）"
        android:layout_marginBottom="8dp" />

</LinearLayout>
